{
  "name": "pi-espresso",
  "version": "0.2.0",
  "description": "Keeps the Mac awake (display + system idle) while the pi agent runs, with a ☕️ terminal title marker. A double shot over caffeinate -i: also prevents display sleep.",
  "keywords": [
    "pi-package",
    "caffeinate",
    "espresso",
    "keep-awake",
    "display-sleep",
    "macos"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "author": "fxtack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxtack/pi-espresso.git"
  },
  "homepage": "https://github.com/fxtack/pi-espresso#readme",
  "bugs": "https://github.com/fxtack/pi-espresso/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
